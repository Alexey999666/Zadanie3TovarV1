<Window x:Class="Zadanie3TovarV1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товары" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed" Icon="/icon.ico" >
    <Window.Resources>
        <Style TargetType="{x:Type ListViewItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProductStatus}" Value="нет в наличии">
                    <Setter Property="Background" Value="Gray"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

       
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="tbUserInfo" FontSize="14" FontWeight="Bold" Margin="5"/>
            <Button Content="Выход" Click="btnLogout_Click" Margin="5" Width="60"/>
        </StackPanel>

      
        <WrapPanel Grid.Row="1" Margin="0,10">
            <TextBox x:Name="tbSearch" Width="200" Margin="5" 
                     TextChanged="tbSearch_TextChanged"/>

            <ComboBox x:Name="cmbManufacturer" Width="150" Margin="5"
                      SelectionChanged="cmbManufacturer_SelectionChanged"/>

            <ComboBox x:Name="cmbSort" Width="150" Margin="5"
                      SelectionChanged="cmbSort_SelectionChanged">
                <ComboBoxItem Tag="0">Без сортировки</ComboBoxItem>
                <ComboBoxItem Tag="1">Цена по возрастанию</ComboBoxItem>
                <ComboBoxItem Tag="2">Цена по убыванию</ComboBoxItem>
            </ComboBox>
        </WrapPanel>

        
        <TextBlock x:Name="tbCountInfo" Grid.Row="2" Margin="5"/>

        
        <ListView x:Name="listViewProducts" Grid.Row="3" Margin="5"
                  MouseDoubleClick="listViewProducts_MouseDoubleClick"
                  SelectionChanged="listViewProducts_SelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" 
                            CornerRadius="5" Padding="10" Margin="5"
                            Background="{Binding ProductQuantityInStock, Converter={x:Null}}">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProductQuantityInStock}" Value="0">
                                        <Setter Property="Background" Value="LightGray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                         
                            <Image Grid.Column="0" Width="80" Height="80" Stretch="UniformToFill"   Source="{Binding ProductPhotoFullPath}">
                                <!--<Image.Source>
                                    <Binding Path="ProductPhoto" Converter="{x:Null}">
                                        <Binding.TargetNullValue>
                                            <BitmapImage UriSource="/Image/picture.png"/>
                                        </Binding.TargetNullValue>
                                        <Binding.FallbackValue>
                                            <BitmapImage UriSource="/Image/picture.png"/>
                                        </Binding.FallbackValue>
                                    </Binding>
                                </Image.Source>-->
                            </Image>

                            
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding ProductName}" 
                                           FontSize="16" FontWeight="Bold"/>

                                <WrapPanel>
                                    <TextBlock Text="Категория: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ProductCategory}"/>
                                </WrapPanel>

                                <WrapPanel>
                                    <TextBlock Text="Производитель: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ProductManufacturer}"/>
                                </WrapPanel>

                                <WrapPanel>
                                    <TextBlock Text="Поставщик: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ProductSupplier}"/>
                                </WrapPanel>

                                <WrapPanel>
                                    <TextBlock Text="Цена: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ProductCost, StringFormat={}{0:F2} руб.}"/>
                                </WrapPanel>

                                <WrapPanel>
                                    <TextBlock Text="Количество на складе: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ProductQuantityInStock}"/>
                                    <TextBlock Text=" "/>
                                    <TextBlock Text="{Binding ProductUnitMeasurement}"/>
                                </WrapPanel>

                                <TextBlock Text="{Binding ProductDescription}" 
                                           TextWrapping="Wrap" MaxHeight="60"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Наличие на складе:" FontWeight="Bold" />
                                <TextBlock Text="{Binding ProductStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

       
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button x:Name="btnAdd" Content="Добавить товар" Width="120" Margin="5"
                    Click="btnAdd_Click" Height="30"/>
            <Button x:Name="btnEdit" Content="Редактировать" Width="100" Margin="5"
                    Click="btnEdit_Click" Height="30"/>
            <Button x:Name="btnDelete" Content="Удалить" Width="80" Margin="5"
                    Click="btnDelete_Click" Height="30"/>
        </StackPanel>
    </Grid>
</Window>