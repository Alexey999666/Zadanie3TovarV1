<Window x:Class="Zadanie3TovarV1.AddEditProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="550" Width="450"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            
            <Label Grid.Row="0" Grid.Column="0" Content="Артикул:" Margin="5"/>
            <TextBox x:Name="txtArticleNumber" Grid.Row="0" Grid.Column="1" 
                     Margin="5" IsReadOnly="True"/>

            
            <Label Grid.Row="1" Grid.Column="0" Content="Наименование:*" Margin="5"/>
            <TextBox x:Name="txtName" Grid.Row="1" Grid.Column="1" Margin="5"/>

           
            <Label Grid.Row="2" Grid.Column="0" Content="Категория:*" Margin="5"/>
            <ComboBox x:Name="cmbCategory" Grid.Row="2" Grid.Column="1" 
                      Margin="5" IsEditable="True"/>

            
            <Label Grid.Row="3" Grid.Column="0" Content="Количество:*" Margin="5"/>
            <TextBox x:Name="txtQuantity" Grid.Row="3" Grid.Column="1" 
                     Margin="5" PreviewTextInput="NumberValidationTextBox"/>

            
            <Label Grid.Row="4" Grid.Column="0" Content="Ед. измерения:*" Margin="5"/>
            <TextBox x:Name="txtUnit" Grid.Row="4" Grid.Column="1" Margin="5"/>

           
            <Label Grid.Row="5" Grid.Column="0" Content="Поставщик:*" Margin="5"/>
            <TextBox x:Name="txtSupplier" Grid.Row="5" Grid.Column="1" Margin="5"/>

           
            <Label Grid.Row="6" Grid.Column="0" Content="Производитель:*" Margin="5"/>
            <ComboBox x:Name="cmbManufacturer" Grid.Row="6" Grid.Column="1" 
                      Margin="5" IsEditable="True"/>

            
            <Label Grid.Row="7" Grid.Column="0" Content="Стоимость:*" Margin="5"/>
            <TextBox x:Name="txtCost" Grid.Row="7" Grid.Column="1" 
                     Margin="5" PreviewTextInput="DecimalValidationTextBox"/>

           
            <Label Grid.Row="8" Grid.Column="0" Content="Макс. скидка %:*" Margin="5"/>
            <TextBox x:Name="txtDiscountMax" Grid.Row="8" Grid.Column="1" 
                     Margin="5" PreviewTextInput="NumberValidationTextBox"/>

           
            <Label Grid.Row="9" Grid.Column="0" Content="Текущая скидка %:" Margin="5"/>
            <TextBox x:Name="txtDiscount" Grid.Row="9" Grid.Column="1" 
                     Margin="5" PreviewTextInput="NumberValidationTextBox"/>

            
            <Label Grid.Row="10" Grid.Column="0" Content="Статус:*" Margin="5"/>
            <TextBox x:Name="txtStatus" Grid.Row="10" Grid.Column="1" Margin="5"/>

           
            <Label Grid.Row="11" Grid.Column="0" Content="Описание:*" Margin="5"/>
            <TextBox x:Name="txtDescription" Grid.Row="11" Grid.Column="1" 
                     Margin="5" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

           
            <StackPanel Grid.Row="12" Grid.ColumnSpan="2" 
                        Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button x:Name="btnSave" Content="Сохранить" Width="80" 
                        Margin="5" Click="btnSave_Click" Height="30"/>
                <Button Content="Отмена" Width="80" Margin="5" 
                        Click="btnCancel_Click" Height="30"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>